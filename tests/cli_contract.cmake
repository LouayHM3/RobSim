file(MAKE_DIRECTORY "${OUTPUT}/empty")
file(WRITE "${OUTPUT}/failing.yaml" "duration: 0.1\nacceptance: {final_error: 0.0}\n")
file(WRITE "${OUTPUT}/invalid.yaml" "dt: 0\n")
file(WRITE "${OUTPUT}/blocked" "file instead of directory")

function(expect_code expected)
  execute_process(COMMAND "${ROBOSIM}" ${ARGN}
    RESULT_VARIABLE actual OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "robosim ${ARGN}: expected exit ${expected}, got ${actual}\n${stdout}\n${stderr}")
  endif()
  set(CLI_STDOUT "${stdout}" PARENT_SCOPE)
endfunction()

expect_code(0 --version)
expect_code(2)
expect_code(2 unknown "${SOURCE}/scenarios/nominal.yaml")
expect_code(2 run "${SOURCE}/scenarios/nominal.yaml" --json)
expect_code(2 run "${SOURCE}/scenarios/nominal.yaml" --unknown x)
expect_code(2 run "${SOURCE}/scenarios/nominal.yaml" --plot "${OUTPUT}/plot.png")
expect_code(2 run "${SOURCE}/scenarios/nominal.yaml" --json a --json b)
expect_code(2 run "${OUTPUT}/invalid.yaml")
expect_code(2 run "${OUTPUT}/missing.yaml")
expect_code(2 run "${SOURCE}/scenarios/nominal.yaml" --output "${OUTPUT}/blocked/subdir")
expect_code(2 verify "${OUTPUT}/empty")
expect_code(2 benchmark "${SOURCE}/scenarios/nominal.yaml" --repeats 0)
expect_code(2 benchmark "${SOURCE}/scenarios/nominal.yaml" --repeats -1)
expect_code(2 benchmark "${SOURCE}/scenarios/nominal.yaml" --repeats 1.5)
expect_code(1 verify "${OUTPUT}/failing.yaml")
expect_code(0 run "${OUTPUT}/failing.yaml")
expect_code(1 benchmark "${OUTPUT}/failing.yaml" --repeats 1)
expect_code(0 benchmark "${SOURCE}/scenarios/nominal.yaml" --repeats 2)
string(JSON passed GET "${CLI_STDOUT}" all_passed)
string(JSON repeats GET "${CLI_STDOUT}" repeats)
if(NOT passed OR NOT repeats EQUAL 2)
  message(FATAL_ERROR "Invalid benchmark output: ${CLI_STDOUT}")
endif()

expect_code(0 verify "${SOURCE}/scenarios/nominal.yaml" --output "${OUTPUT}/single")
expect_code(0 run "${SOURCE}/scenarios/nominal.yaml"
  --json "${OUTPUT}/run.json" --csv "${OUTPUT}/run.csv" --plot "${OUTPUT}/run.svg")
foreach(name single/report.md single/trajectory.svg run.json run.csv run.svg)
  if(NOT EXISTS "${OUTPUT}/${name}")
    message(FATAL_ERROR "Missing CLI artifact: ${name}")
  endif()
endforeach()

file(MAKE_DIRECTORY "${OUTPUT}/duplicates")
file(WRITE "${OUTPUT}/duplicates/same.yaml" "duration: 0.1\n")
file(WRITE "${OUTPUT}/duplicates/same.yml" "duration: 0.1\n")
expect_code(2 verify "${OUTPUT}/duplicates")
message(STATUS "CLI exit codes, exports, and validation passed")
